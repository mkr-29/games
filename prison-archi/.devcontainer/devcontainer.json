{
  "name": "prison-architect-web-devcontainer",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [5173],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "svelte.svelte-vscode",
        "bradlc.vscode-tailwindcss",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "postCreateCommand": "npm install && cargo check --manifest-path crates/simulation/Cargo.toml"
}
